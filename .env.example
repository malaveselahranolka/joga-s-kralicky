# =====================================================================
#  Vzor proměnných prostředí. Zkopíruj na .env.local a doplň hodnoty.
#  .env.local je v .gitignore — NIKDY ho necommituj.
#
#  Ostrá hodnota většiny z nich žije ve Vercelu, ne tady. Stáhneš je:
#      vercel env pull .env.local
#
#  Tenhle soubor je jen seznam toho, CO všechno musí být nastavené —
#  bez něj se nedá nový vývojář ani nové prostředí rozjet, protože
#  build bez SANITY project ID rovnou spadne.
# =====================================================================

# ---------------------------------------------------------------------
#  SANITY (CMS) — build a /api/content
#  Kde: Vercel → Settings → Environment Variables
# ---------------------------------------------------------------------
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Čtecí token pro serverovou funkci /api/content (Viewer stačí).
# Sanity → Manage → API → Tokens
SANITY_API_READ_TOKEN=

# Zapisovací token — POUZE pro `npm run seed` a `npm run sync-content`.
# Ve Vercelu být nemusí a být nemá.
SANITY_API_WRITE_TOKEN=

# Adresa, kterou Studio otevírá v náhledu (obvykle produkční doména).
SANITY_STUDIO_PREVIEW_URL=https://www.jogaskralicky.cz

# ---------------------------------------------------------------------
#  SUPABASE EDGE FUNKCE — tohle NEPATŘÍ do .env.local!
#  Nastavuje se výhradně jako Supabase secrets:
#      supabase secrets set STRIPE_SECRET_KEY=sk_live_...
#  Je tu jen proto, aby byl vidět úplný seznam.
# ---------------------------------------------------------------------
#  SUPABASE_URL                 doplní Supabase samo
#  SUPABASE_SERVICE_ROLE_KEY    doplní Supabase samo
#  STRIPE_SECRET_KEY            sk_test_… / sk_live_…
#  STRIPE_WEBHOOK_SECRET        whsec_… z Dashboard → Developers → Webhooks
#  EMAILJS_PRIVATE_KEY          ← JEDINÉ, co ještě chybí doplnit.
#                               EmailJS → Account → Security → Private Key.
#                               Tamtéž povol API požadavky mimo prohlížeč.
#                               Bez něj se e-maily jen řadí do fronty a
#                               neodesílají — v adminu je vidět proč.
#  PAYMENT_ENTRY_CZK            499 — MUSÍ sedět s entryCzk v payment-config.js
#  PAYMENT_VOUCHER_CZK          499 — MUSÍ sedět s voucherCzk v payment-config.js
#  SITE_URL                     https://www.jogaskralicky.cz/

# ---------------------------------------------------------------------
#  EMAILJS — běží v prohlížeči, takže se nastavuje v supabase-config.js
#  jako window.EMAILJS_*. Veřejný klíč není tajný, ale patří k seznamu:
#      EMAILJS_PUBLIC_KEY, EMAILJS_SERVICE_ID,
#      EMAILJS_TEMPLATE_ID, EMAILJS_VOUCHER_TEMPLATE_ID,
#      EMAILJS_NEWSLETTER_TEMPLATE_ID
# ---------------------------------------------------------------------
